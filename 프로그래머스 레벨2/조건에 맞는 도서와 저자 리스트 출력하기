문제: '경제' 카테고리에 속하는 도서들의 도서 ID(BOOK_ID), 저자명(AUTHOR_NAME), 출판일(PUBLISHED_DATE) 리스트를 출력하는 SQL문을 작성해주세요.
결과는 출판일을 기준으로 오름차순 정렬해주세요.

# 방법 1. 일반 JOIN 
SELECT A.BOOK_ID, B.AUTHOR_NAME, A.PUBLISHED_DATE
FROM BOOK A JOIN AUTHOR B
ON A.AUTHOR_ID = B.AUTHOR_ID
WHERE A.CATEGORY = '경제'
ORDER BY A.PUBLISHED_DATE

# 방법 2. 날짜함수를 정의하고, WHERE 절에서 조인을 함 
SELECT A.BOOK_ID, B.AUTHOR_NAME, DATE_FORMAT(A.PUBLISHED_DATE, '%Y-%m-%d') AS PUBLISHED_DATE
FROM BOOK A , AUTHOR B
WHERE A.AUTHOR_ID = B.AUTHOR_ID
AND A.CATEGORY = '경제'
ORDER BY A.PUBLISHED_DATE

# 방법 3. 서브쿼리를 이용하여 풀이
SELECT A.BOOK_ID, B.AUTHOR_NAME, DATE_FORMAT(A.PUBLISHED_DATE, '%Y-%m-%d') AS PUBLISHED_DATE
FROM (SELECT BOOK_ID, AUTHOR_ID, PUBLISHED_DATE
     FROM BOOK
     WHERE CATEGORY = '경제') A JOIN AUTHOR B
     ON A.AUTHOR_ID = B.AUTHOR_ID
ORDER BY A.PUBLISHED_DATE
